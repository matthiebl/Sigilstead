{
  "schemaVersion": 1,
  "id": "heartstead",
  "version": "${version}",
  "name": "Heartstead",
  "description": "Explore, don't grind. Removes the need for technical farms and chest-sorting, and pays you for exploring, fighting and building instead.",
  "authors": [
    "Matt"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/heartstead/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.heartstead.Heartstead"
    ],
    "client": [
      "com.heartstead.client.HeartsteadClient"
    ],
    "fabric-gametest": [
      "com.heartstead.gametest.HeartsteadGameTests",
      "com.heartstead.gametest.VillagerTradePersistenceGameTests",
      "com.heartstead.gametest.VaultGameTests",
      "com.heartstead.gametest.VaultMenuGameTests",
      "com.heartstead.gametest.VaultActivationGameTests",
      "com.heartstead.gametest.VaultUpgradeSlotGameTests",
      "com.heartstead.gametest.VaultVariantGameTests",
      "com.heartstead.gametest.CodexGameTests",
      "com.heartstead.gametest.CodexTeachGameTests",
      "com.heartstead.gametest.CoreImprintGameTests",
      "com.heartstead.gametest.CoreYieldGameTests",
      "com.heartstead.gametest.CoreAccrualGameTests",
      "com.heartstead.gametest.CoreSocketGameTests",
      "com.heartstead.gametest.CoreVaultGameTests",
      "com.heartstead.gametest.CoreHousingMenuGameTests",
      "com.heartstead.gametest.CoreUpgradeGameTests",
      "com.heartstead.gametest.CoreImprintTagGameTests",
      "com.heartstead.gametest.DiscoveryPathGameTests"
    ]
  },
  "mixins": [
    "heartstead.mixins.json",
    {
      "config": "heartstead.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
